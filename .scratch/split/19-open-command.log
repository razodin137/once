package command

import (
	"context"
	"fmt"

	"charm.land/lipgloss/v2"
	"github.com/spf13/cobra"

	"github.com/basecamp/once/internal/docker"
)

var hostStyle = lipgloss.NewStyle().Foreground(lipgloss.BrightBlue)

type listCommand struct {
	cmd *cobra.Command
}

func newListCommand() *listCommand {
	l := &listCommand{}
	l.cmd = &cobra.Command{
		Use:     "list",
		Aliases: []string{"ls"},
		Short:   "List installed applications",
		RunE:    WithNamespace(l.run),
	}
	return l
}

// Private

func (l *listCommand) run(_ context.Context, ns *docker.Namespace, cmd *cobra.Command, args []string) error {
	for _, app := range ns.Applications() {
		status := "stopped"
		if app.Running {
			status = "running"
		}

		host := hostStyle.Hyperlink(app.URL()).Render(app.Settings.Host)

		fmt.Printf("%s (%s)\n", host, status)
	}

	return nil
}
package docker

import (
	"fmt"
	"html/template"
	"io"
	"io/fs"
	"net/url"
	"os"
	"path/filepath"
	"slices"
	"strings"
)

const (
	siteIndexName = "index.html"
	siteHTMLExt   = ".html"
)

// IsSiteFile reports whether path names a single HTML file that can be served
// as a site in its own right.
func IsSiteFile(path string) bool {
	return strings.EqualFold(filepath.Ext(path), siteHTMLExt)
}

// ServeSite copies source into a fresh directory in the served site cache and
// returns its path. Folders without an index.html get a generated contents
// page in the copy, so the source is left untouched. A single HTML file is
// served as the site's index.html.
func ServeSite(name, source string) (string, error) {
	dir, err := servedSiteDir(name)
	if err != nil {
		return "", err
	}

	if err := os.MkdirAll(dir, 0o755); err != nil {
		return "", fmt.Errorf("creating served site directory: %w", err)
	}

	revision, err := randomID(8)
	if err != nil {
		return "", fmt.Errorf("generating served site id: %w", err)
	}

	dest := filepath.Join(dir, revision)
	if err := BuildServedSite(source, dest); err != nil {
		os.RemoveAll(dest)
		return "", err
	}

	return dest, nil
}

// RemoveServedSite deletes every served copy belonging to name, along with any
// generated pages, and prunes the site cache once it is empty.
func RemoveServedSite(name string) error {
	if name == "" {
		return fmt.Errorf("served site name is required")
	}

	root, err := servedSiteRoot()
	if err != nil {
		return err
	}

	if err := os.RemoveAll(filepath.Join(root, "sites", name)); err != nil {
		return err
	}

	removeIfEmpty(filepath.Join(root, "sites"))
	removeIfEmpty(root)

	return nil
}

// RemoveServedCopy deletes a single served copy, such as the previous version
// of a site after a redeploy.
func RemoveServedCopy(path string) error {
	return os.RemoveAll(path)
}

// BuildServedSite builds the served copy of source in dest. Markdown files are
// rendered as HTML documents, and every folder in the copy that has no
// index.html gets a generated contents page. A folder made up entirely of
// Markdown documents opens its first one instead. A single file is served as
// the site's index.html.
func BuildServedSite(source, dest string) error {
	root, err := filepath.EvalSymlinks(source)
	if err != nil {
		return err
	}

	info, err := os.Stat(root)
	if err != nil {
		return err
	}

	if err := os.MkdirAll(dest, 0o755); err != nil {
		return err
	}

	if !info.IsDir() {
		if !info.Mode().IsRegular() {
			return fmt.Errorf("unsupported site source: %s", source)
		}
		return copySiteFile(root, filepath.Join(dest, siteIndexName))
	}

	if err := copyTree(root, dest); err != nil {
		return err
	}

	if err := renderMarkdownDocuments(root, dest); err != nil {
		return err
	}

	return writeContentsPages(root, dest)
}

// Helpers

func servedSiteRoot() (string, error) {
	cache, err := os.UserCacheDir()
	if err != nil {
		return "", fmt.Errorf("determining cache directory: %w", err)
	}

	return filepath.Join(cache, "once"), nil
}

func servedSiteDir(name string) (string, error) {
	root, err := servedSiteRoot()
	if err != nil {
		return "", err
	}

	return filepath.Join(root, "sites", name), nil
}

func removeIfEmpty(path string) {
	_ = os.Remove(path)
}

func copyTree(root, dest string) error {
	return filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
		if err != nil {
			return err
		}

		rel, err := filepath.Rel(root, path)
		if err != nil {
			return err
		}
		target := filepath.Join(dest, rel)

		switch {
		case entry.IsDir():
			return os.MkdirAll(target, 0o755)
		case entry.Type()&fs.ModeSymlink != 0:
			link, err := os.Readlink(path)
			if err != nil {
				return err
			}
			return os.Symlink(link, target)
		case entry.Type().IsRegular():
			return copySiteFile(path, target)
		default:
			return nil
		}
	})
}

// copySiteFile writes a world-readable copy, so nginx's worker user can serve
// it whatever the permissions of the source file are.
func copySiteFile(source, target string) error {
	src, err := os.Open(source)
	if err != nil {
		return err
	}
	defer src.Close()

	dst, err := os.OpenFile(target, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)
	if err != nil {
		return err
	}

	if _, err := io.Copy(dst, src); err != nil {
		dst.Close()
		return err
	}

	return dst.Close()
}

func writeContentsPages(root, dest string) error {
	return filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		if !entry.IsDir() || hasSiteIndex(path) {
			return nil
		}

		rel, err := filepath.Rel(root, path)
		if err != nil {
			return err
		}

		return writeContentsPage(path, rel, filepath.Join(dest, rel, siteIndexName))
	})
}

func hasSiteIndex(dir string) bool {
	_, err := os.Lstat(filepath.Join(dir, siteIndexName))
	return err == nil
}

type contentsPage struct {
	Name    string
	Parent  string
	Entries []contentsEntry
	Count   string
}

type contentsEntry struct {
	Name     string
	Href     template.URL
	Dir      bool
	Size     string
	Modified string
}

func writeContentsPage(dir, rel, target string) error {
	entries, err := os.ReadDir(dir)
	if err != nil {
		return err
	}

	slices.SortFunc(entries, compareEntries)

	if first, ok := firstMarkdownEntry(entries); ok {
		return writeMarkdownPage(filepath.Join(dir, first.Name()), target)
	}

	page := contentsPage{
		Name:    filepath.Base(dir),
		Entries: make([]contentsEntry, 0, len(entries)),
	}

	if rel != "." {
		page.Parent = "../"
	}

	for _, entry := range entries {
		info, err := entry.Info()
		if err != nil {
			return err
		}

		size := "—"
		if !entry.IsDir() {
			size = formatSiteSize(info.Size())
		}

		page.Entries = append(page.Entries, contentsEntry{
			Name:     entry.Name(),
			Href:     siteEntryHref(entry),
			Dir:      entry.IsDir(),
			Size:     size,
			Modified: info.ModTime().Format("2006-01-02 15:04"),
		})
	}

	page.Count = formatEntryCount(len(page.Entries))

	file, err := os.OpenFile(target, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)
	if err != nil {
		return err
	}
	defer file.Close()

	return contentsTemplate.Execute(file, page)
}

func compareEntries(a, b fs.DirEntry) int {
	if a.IsDir() != b.IsDir() {
		if a.IsDir() {
			return -1
		}
		return 1
	}

	if result := strings.Compare(strings.ToLower(a.Name()), strings.ToLower(b.Name())); result != 0 {
		return result
	}

	return strings.Compare(a.Name(), b.Name())
}

func siteEntryHref(entry fs.DirEntry) template.URL {
	href := url.PathEscape(entry.Name())
	if entry.IsDir() {
		href += "/"
	}

	return template.URL(href)
}

func formatSiteSize(size int64) string {
	const unit = 1000

	if size < unit {
		return fmt.Sprintf("%d B", size)
	}

	div, exp := int64(unit), 0
	for size >= div*unit && exp < 4 {
		div *= unit
		exp++
	}

	return fmt.Sprintf("%.1f %cB", float64(size)/float64(div), "kMGTP"[exp])
}

func formatEntryCount(count int) string {
	if count == 1 {
		return "1 entry"
	}

	return fmt.Sprintf("%d entries", count)
}


	assert.Equal(t, "5m", formatBackupAge(5*time.Minute))
	assert.Equal(t, "3h", formatBackupAge(3*time.Hour))
	assert.Equal(t, "2d 4h", formatBackupAge(52*time.Hour))
	assert.Equal(t, "3d", formatBackupAge(72*time.Hour))
}

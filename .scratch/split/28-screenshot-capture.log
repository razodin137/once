	require.NoError(t, err)

	return ns
}

func listCommandFor(t *testing.T, now time.Time, state *docker.State) *listCommand {
	t.Helper()

	l := newListCommand()
	l.now = func() time.Time { return now }
	l.loadState = func(context.Context, *docker.Namespace) (*docker.State, error) {
		return state, nil
	}
	return l
}

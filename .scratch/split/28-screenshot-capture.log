const (
	siteIndexName = "index.html"
	siteHTMLExt   = ".html"
)

// IsSiteFile reports whether path names a single HTML file that can be served
// as a site in its own right.
func IsSiteFile(path string) bool {
	return strings.EqualFold(filepath.Ext(path), siteHTMLExt)
}

// ServeSite copies source into a fresh directory in the served site cache and
// returns its path. Folders without an index.html get a generated contents
// page in the copy, so the source is left untouched. A single HTML file is
// served as the site's index.html.
func ServeSite(name, source string) (string, error) {
	dir, err := servedSiteDir(name)
	if err != nil {
		return "", err
	}

	if err := os.MkdirAll(dir, 0o755); err != nil {
		return "", fmt.Errorf("creating served site directory: %w", err)
	}

	revision, err := randomID(8)
	if err != nil {
		return "", fmt.Errorf("generating served site id: %w", err)
	}

	dest := filepath.Join(dir, revision)
	if err := BuildServedSite(source, dest); err != nil {
		os.RemoveAll(dest)
		return "", err
	}

	return dest, nil
}

// RemoveServedSite deletes every served copy belonging to name, along with any
// generated pages, and prunes the site cache once it is empty.
func RemoveServedSite(name string) error {
	if name == "" {
		return fmt.Errorf("served site name is required")
	}

	root, err := servedSiteRoot()
	if err != nil {
		return err
	}

	if err := os.RemoveAll(filepath.Join(root, "sites", name)); err != nil {
		return err
	}

	removeIfEmpty(filepath.Join(root, "sites"))
	removeIfEmpty(root)

	return nil
}

// RemoveServedCopy deletes a single served copy, such as the previous version
// of a site after a redeploy.
func RemoveServedCopy(path string) error {

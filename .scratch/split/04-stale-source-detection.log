package docker

import (
	"crypto/rand"
	"encoding/hex"
	"path/filepath"
	"regexp"
	"strings"
	"time"

	"github.com/distribution/reference"
)

const streamRetryDelay = time.Second

var pathSeparators = regexp.MustCompile(`[^a-z0-9]+`)

func IsLocalhost(host string) bool {
	return host == "localhost" || strings.HasSuffix(host, ".localhost")
}

func NameFromImageRef(imageRef string) string {
	named, err := reference.ParseNormalizedNamed(imageRef)
	if err != nil {
		return imageRef
	}
	path := reference.Path(named)
	parts := strings.Split(path, "/")
	return parts[len(parts)-1]
}

func NameFromPath(path string) string {
	name := pathSeparators.ReplaceAllString(strings.ToLower(filepath.Base(filepath.Clean(path))), "-")
	name = strings.Trim(name, "-")

	if name == "" {
		return "site"
	}

	if len(name) > 63 {
		name = strings.Trim(name[:63], "-")
	}

	return name
}

func ContainerRandomID() (string, error) {
	return randomID(6)
}

func randomID(length int) (string, error) {
	bytes := make([]byte, length)
	if _, err := rand.Read(bytes); err != nil {
		return "", err
	}
	return hex.EncodeToString(bytes)[:length], nil
}

// cutLast splits s around the last occurrence of sep, like strings.Cut but
// from the right.
func cutLast(s, sep string) (before, after string, found bool) {
	return strings.CutLast(s, sep)
}

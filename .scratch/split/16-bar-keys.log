+func TestAppBarBindsKeyboardShortcuts(t *testing.T) {
+	ns := namespaceWithApps(
+		ApplicationSettings{Name: "alpha", Host: "alpha.localhost"},
+		ApplicationSettings{Name: "beta", Host: "beta.localhost"},
+	)
+
+	bar := ns.Application("beta").appBar()
+
+	assert.Contains(t, bar, `case "/"`)
+	assert.Contains(t, bar, `case "["`)
+	assert.Contains(t, bar, `case "]"`)
+	assert.Contains(t, bar, `case "c"`)
+	assert.Contains(t, bar, `case "r"`)
+	assert.Contains(t, bar, `case "R"`)
+	assert.Contains(t, bar, `case "h"`)
+	assert.Contains(t, bar, `back: "http://alpha.localhost"`)
+	assert.Contains(t, bar, `next: "http://alpha.localhost"`)
+	assert.Contains(t, bar, `contents: "/"`)
+}
+
+func TestAppBarMenuItemShowsShortcutHints(t *testing.T) {
+	ns := namespaceWithApps(
+		ApplicationSettings{Name: "alpha", Host: "alpha.localhost"},
+		ApplicationSettings{Name: "beta", Host: "beta.localhost"},
+	)
+
+	bar := ns.Application("beta").appBar()
+
+	assert.Contains(t, bar, `data-once="menu"`)
+	assert.Contains(t, bar, `id="once-bar-menu"`)
+	assert.Contains(t, bar, `<kbd>[</kbd>`)
+	assert.Contains(t, bar, `<kbd>]</kbd>`)
+	assert.Contains(t, bar, `<kbd>C</kbd>`)
+	assert.Contains(t, bar, `<kbd>R</kbd>`)
+	assert.Contains(t, bar, `<kbd>shift R</kbd>`)
+	assert.Contains(t, bar, `<kbd>H</kbd>`)
+}
+
+func TestAppBarMenuOmitsUnavailableActions(t *testing.T) {
+	ns := namespaceWithApps(ApplicationSettings{Name: "only", Host: "only.localhost"})
+
+	bar := ns.Application("only").appBar()
+
+	assert.NotContains(t, bar, `data-once="back"`)
+	assert.NotContains(t, bar, `data-once="next"`)
+	assert.NotContains(t, bar, `<kbd>[</kbd>`)
+	assert.NotContains(t, bar, `<kbd>]</kbd>`)
+	assert.Contains(t, bar, `<kbd>C</kbd>`)
+	assert.Contains(t, bar, `<kbd>H</kbd>`)
+}

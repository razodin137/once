	error
	ExitCode() int
}

func ExitCode(err error) (int, bool) {
	if e, ok := errors.AsType[exitCoder](err); ok {
		return e.ExitCode(), true
	}
	return 0, false
}

func IsExitError(err error) bool {
	_, ok := ExitCode(err)

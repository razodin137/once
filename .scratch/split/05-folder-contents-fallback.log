		require.NoError(t, err)

		require.NoError(t, os.WriteFile(file, []byte("bye"), 0o644))

		after, err := withSourceHash(docker.ApplicationSettings{Source: dir}, dir)
		require.NoError(t, err)
		assert.NotEqual(t, before.SourceHash, after.SourceHash)
	})

